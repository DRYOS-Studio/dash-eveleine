# Supabase do Partiu Empreender. Usado SÓ no servidor.
SUPABASE_URL=
# Chave service_role. NUNCA prefixe com NEXT_PUBLIC_ — não pode ir pro browser.
SUPABASE_SERVICE_ROLE_KEY=

# Token secreto do webhook Hotmart (validado no header X-HOTMART-HOTTOK)
HOTMART_HOTTOK=

# Senha única de acesso à dashboard
DASHBOARD_PASSWORD=

# Segredo p/ assinar o cookie de sessão (string aleatória longa). Sem fallback: ausente = erro.
AUTH_SECRET=
