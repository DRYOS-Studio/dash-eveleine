# Supabase — projeto de leads (outra org). Usado SÓ no servidor.
# Pegue em: Supabase Dashboard > Project Settings > API
SUPABASE_URL=
# Chave secreta service_role. NUNCA prefixe com NEXT_PUBLIC_ — não pode ir pro browser.
SUPABASE_SERVICE_ROLE_KEY=

# Senha única de acesso à dashboard
DASHBOARD_PASSWORD=troque-esta-senha

# Segredo p/ assinar o cookie de sessão (string aleatória longa). Sem fallback: ausente = erro.
AUTH_SECRET=gere-uma-string-aleatoria-longa

# Calendly — Personal Access Token de um usuário ADMIN/OWNER da organização.
# Sem papel de admin a API só devolve os eventos do próprio usuário e o painel
# de Agenda fica cego pro resto do time. Gere em:
# calendly.com > Integrations > API and webhooks > Personal Access Tokens
CALENDLY_TOKEN=
# Opcional: URI da organização. Vazio = descoberto via GET /users/me e cacheado.
CALENDLY_ORG_URI=
